{
  "extends": "@slipstream/tsconfig/node-pkg.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
        "ignoreDeprecations":"6.0",
    "types": ["*"]
  },

  "include": [
    "**/*.ts",
    "src/index.ts",
    "src/service/index.ts",
    "src/service/types.ts",
    "src/**/*.ts",
    "**/*.mjs",
    "**/*.preset.ts",
    "tsdown.config.ts"
  ],
  "exclude": ["dist"]
}
