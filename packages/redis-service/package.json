{
  "name": "@slipstream/redis-service",
  "version": "1.0.0",
  "description": "convenient redis util",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "context": [
          "dist/context/index.d.ts"
        ],
        "redis": [
          "dist/service/index.d.ts"
        ],
        "types": [
          "dist/service/types.d.ts"
        ],
        "pubsub": [
          "dist/pubsub/channels.d.ts",
          "dist/pubsub/enhanced-client.d.ts",
          "dist/pubsub/extended-events.d.ts"
        ]
      }
    }
  },
  "license": "BUSL-1.1",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "redis": [
        "dist/service/index.d.ts"
      ],
      "context": [
        "dist/context/index.d.ts"
      ],
      "types": [
        "dist/service/types.d.ts"
      ],
      "pubsub": [
        "dist/pubsub/channels.d.ts",
        "dist/pubsub/enhanced-client.d.ts",
        "dist/pubsub/extended-events.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,d.ts,d.cts,css}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./context": "./dist/context/index.js",
    "./redis": "./dist/service/index.js",
    "./types": "./dist/service/types.js",
    "./pubsub/channels": "./dist/pubsub/channels.js",
    "./pubsub/enhanced-client": "./dist/pubsub/enhanced-client.js",
    "./pubsub/extended-events": "./dist/pubsub/extended-events.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm build",
    "lint": "eslint",
    "clean": "git clean -xdf .turbo dist node_modules",
    "typecheck": "tsgo --noEmit",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml,css,html,md}\" --ignore-unknown --cache"
  },
  "dependencies": {
    "@slipstream/types": "workspace:*",
    "dotenv": "catalog:dotenv",
    "dotenv-expand": "catalog:dotenv",
    "redis": "catalog:redis"
  },
  "devDependencies": {
    "@d0paminedriven/fs": "catalog:dd",
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@typescript/native-preview": "catalog:tsgo",
    "dotenv-cli": "catalog:dotenv",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint"
  },
  "prettier": "@slipstream/prettier-config"
}
