datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
  output                 = "../../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  compilerBuild          = "fast"
  previewFeatures        = ["typedSql", "relationJoins"]
}

enum Provider {
  OPENAI
  GROK
  GEMINI
  ANTHROPIC
  META
  VERCEL
  MISTRAL
  COHERE
  MOONSHOTAI
  DEEPSEEK
  ZAI
}

model User {
  id                      String                   @id @default(cuid(2))
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  email_verified          Boolean?
  image                   String?
  isAnonymous             Boolean?
  lastLoginMethod         String?
  profile                 Profile?
  accounts                Account[]
  sessions                Session[]
  keys                    UserKey[]
  attachments             Attachment[]
  conversations           Conversation[]
  conversationMemoryStore ConversationMemoryStore?
  providerStores          ProviderStore[]
  settings                Settings?
  userStores              UserStore[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}
