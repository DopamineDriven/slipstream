model Profile {
  id         String  @id @default(cuid(2))
  bio        String?
  city       String?
  region     String?
  country    String?
  postalCode String?
  lat        Float?
  lng        Float?
  timezone   String?
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String  @unique
}
