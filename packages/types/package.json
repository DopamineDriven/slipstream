{
  "name": "@slipstream/types",
  "version": "1.1.0",
  "description": "convenient type definitions",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/index.d.ts"
        ],
        "contract": [
          "dist/contract/*.d.ts"
        ],
                "image-gen": [
          "dist/image-gen/*.d.ts"
        ],
        "models": [
          "dist/models.d.ts"
        ],
        "utils": [
          "dist/utils.d.ts"
        ],
        "types": [
          "dist/types.d.ts"
        ],
        "codegen-types": [
          "dist/codegen-types.d.ts"
        ],
        "codegen": [
          "dist/codegen/__gen__/*.d.ts"
        ],
        "stt": [
          "dist/stt.d.ts"
        ],
        "tts": [
          "dist/tts.d.ts"
        ]
      }
    }
  },
  "license": "BUSL-1.1",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "contract": [
        "dist/contract/*.d.ts"
      ],
                      "image-gen": [
          "dist/image-gen/*.d.ts"
        ],
      "models": [
        "dist/models.d.ts"
      ],
      "utils": [
        "dist/utils.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ],
      "codegen-types": [
        "dist/codegen-types.d.ts"
      ],
      "codegen": [
        "dist/codegen/__gen__/*.d.ts"
      ],
      "stt": [
        "dist/stt.d.ts"
      ],
      "tts": [
        "dist/tts.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,mjs,d.ts,d.cts,d.mts}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./utils": "./dist/utils.js",
    "./types": "./dist/types.js",
    "./models": "./dist/models.js",
    "./contract/*": "./dist/contract/*.js",
    "./image-gen/*": "./dist/image-gen/*.js",
    "./codegen-types": "./dist/codegen-types.js",
    "./codegen/*": "./dist/codegen/__gen__/*.js",
    "./stt": "./dist/stt.js",
    "./tts": "./dist/tts.js"
  },
  "scripts": {
    "prebuild": "pnpm gen:tsdown",
    "gen:tsdown": "tsx src/services/automate-tsdown.ts --target gen",
    "postgen:tsdown": "prettier --write tsdown.config.ts --ignore-unknown --cache",
    "build": "tsdown",
    "dev": "pnpm build",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml}\" --ignore-unknown --cache",
    "clean": "git clean -xdf .turbo dist node_modules",
    "gen:audio": "tsx src/codegen/index.ts --target audio",
    "gen:image": "tsx src/codegen/index.ts --target img",
    "gen:video": "tsx src/codegen/index.ts --target video",
    "gen:default": "tsx src/codegen/index.ts --target default",
    "gen": "pnpm gen:audio && pnpm gen:image && pnpm gen:video && pnpm gen:default",
    "postgen": "pnpm format",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@d0paminedriven/fs": "catalog:dd",
    "@slipstream/db": "workspace:*",
    "@types/ws": "catalog:ws",
    "dotenv": "catalog:dotenv",
    "ws": "catalog:ws"
  },
  "devDependencies": {
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@typescript/native-preview": "catalog:tsgo",
    "dotenv-expand": "catalog:dotenv",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint"
  },
  "prettier": "@slipstream/prettier-config"
}
