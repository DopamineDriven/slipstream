{
  "extends": "@slipstream/tsconfig/node-pkg.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "types": ["*"],
    "sourceMap": false,
    "declarationMap": false
  },
  "include": [
    "**/*.ts",
    "src/**/*.ts",
    "**/*.mjs",
    "**/*.preset.ts",
    "tsdown.config.ts"
  ],
  "exclude": ["dist"]
}
