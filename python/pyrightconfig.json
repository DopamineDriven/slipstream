{
    "include": [
        "app"
    ],
    "pythonVersion": "3.13",
    "venvPath": ".",
    "venv": ".venv",
    "executionEnvironments": [
        {
            "root": ".",
            "pythonVersion": "3.13",
            "extraPaths": ["."]
        }
    ],
    "exclude": [
        ".venv",
        "venv",
        "node_modules",
        "__pycache__",
        "**/__pycache__",
        "build",
        "dist"
    ],
    "typeCheckingMode": "strict",
    "useLibraryCodeForTypes": true,
    "reportMissingTypeStubs": false,
    "stubPath": "./typings"
}
