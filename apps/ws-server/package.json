{
  "name": "@slipstream/ws-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "alibaba": [
        "dist/alibaba/*.d.ts"
      ],
      "anthropic": [
        "dist/anthropic/*.d.ts"
      ],
      "byte-codec": [
        "dist/byte-codec/*.d.ts"
      ],
      "cohere": [
        "dist/cohere/*.d.ts"
      ],
      "deepseek": [
        "dist/deepseek/*.d.ts"
      ],
      "extract": [
        "dist/extract/*.d.ts"
      ],
      "gemini": [
        "dist/gemini/*.d.ts"
      ],
      "image": [
        "dist/image/*.d.ts"
      ],
      "kimi": [
        "dist/kimi/*.d.ts"
      ],
      "local-tools": [
        "dist/local-tools/*.d.ts"
      ],
      "logger": [
        "dist/logger/*.d.ts"
      ],
      "memory": [
        "dist/memory/*.d.ts"
      ],
      "meta": [
        "dist/meta/*.d.ts"
      ],
      "minimax": [
        "dist/minimax/*.d.ts"
      ],
      "mistral": [
        "dist/mistral/*.d.ts"
      ],
      "mixins": [
        "dist/mixins/*.d.ts"
      ],
      "models": [
        "dist/models/*.d.ts"
      ],
      "openai": [
        "dist/openai/*.d.ts"
      ],
      "pdf": [
        "dist/pdf/*.d.ts"
      ],
      "prisma": [
        "dist/prisma/*.d.ts"
      ],
      "providers": [
        "dist/providers/*.d.ts"
      ],
      "resolver": [
        "dist/resolver/*.d.ts"
      ],
      "sakana": [
        "dist/sakana/*.d.ts"
      ],
      "sharp": [
        "dist/sharp/*.ts"
      ],
      "store": [
        "dist/store/*.d.ts"
      ],
      "stt": [
        "dist/stt/*.d.ts"
      ],
      "tool-catalog": [
        "dist/tool-catalog/*.d.ts"
      ],
      "tts": [
        "dist/tts/*.d.ts"
      ],
      "types": [
        "dist/types/*.d.ts"
      ],
      "vercel": [
        "dist/vercel/*.d.ts"
      ],
      "voyage": [
        "dist/voyage/*.d.ts"
      ],
      "ws-server": [
        "dist/ws-server/*.d.ts"
      ],
      "xai": [
        "dist/xai/*.d.ts"
      ],
      "zai": [
        "dist/zai/*.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "prebuild": "pnpm gen:tsdown && prettier --write tsdown.config.ts --ignore-unknown --cache",
    "gen:tsdown": "tsx src/test/automate-tsdown.ts --target gen --ignore !src/__out__/**/*,!src/test/**/*,!src/tests/**/*,!public/**/*",
    "pre:build": "pnpm db:generate",
    "db:generate": "pnpm --filter @slipstream/db db:generate",
    "db:migrate": "pnpm --filter @slipstream/db db:migrate",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml,md}\" \"*.{ts,json}\" --ignore-unknown --cache",
    "prisma:studio": "pnpm --filter @slipstream/db prisma:studio",
    "clean": "git clean -xdf .turbo dist node_modules",
    "dev": "nodemon --watch src --ext ts --exit-child --exec \"tsx src/index.ts\"",
    "lint": "eslint",
    "typecheck": "tsgo --noEmit",
    "start": "node dist/index.js",
    "test": "node --test --import tsx --test-reporter spec",
    "test:xai": "node --test --import tsx --test-reporter spec src/tests/xai-responses-thinking.tests.ts",
    "test:store": "node --test --import tsx --test-reporter spec src/tests/store.tests.ts",
    "test:voyage": "tsx src/test/voyage-tokenize.ts"
  },
  "prettier": "@slipstream/prettier-config",
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:anthropic",
    "@aws-sdk/client-s3": "catalog:aws",
    "@aws-sdk/client-secrets-manager": "catalog:aws",
    "@aws-sdk/credential-providers": "catalog:aws",
    "@aws-sdk/s3-request-presigner": "catalog:aws",
    "@aws-sdk/types": "catalog:aws",
    "@d0paminedriven/audiodown": "catalog:dd",
    "@d0paminedriven/fs": "catalog:dd",
    "@d0paminedriven/metadata": "catalog:dd",
    "@d0paminedriven/pdfdown": "catalog:dd",
    "@google/genai": "catalog:google",
    "@mistralai/mistralai": "catalog:mistral",
    "@modelcontextprotocol/sdk": "catalog:mcp",
    "@napi-rs/canvas": "catalog:napi",
    "@paralleldrive/cuid2": "catalog:cuid2",
    "@slipstream/credentials": "workspace:*",
    "@slipstream/db": "workspace:*",
    "@slipstream/encryption": "workspace:*",
    "@slipstream/img-gen": "workspace:*",
    "@slipstream/key-validator": "workspace:*",
    "@slipstream/redis-service": "workspace:*",
    "@slipstream/storage-s3": "workspace:*",
    "@slipstream/types": "workspace:*",
    "@types/node": "catalog:node",
    "@types/pg": "catalog:pg",
    "@types/ws": "catalog:ws",
    "@typescript/native-preview": "catalog:tsgo",
    "cohere-ai": "catalog:cohere",
    "dotenv": "catalog:dotenv",
    "dotenv-cli": "catalog:dotenv",
    "dotenv-expand": "catalog:dotenv",
    "fflate": "catalog:fflate",
    "nanoid": "catalog:nanoid",
    "node-html-parser": "catalog:node",
    "openai": "catalog:openai",
    "p-limit": "catalog:p-limit",
    "pg": "catalog:pg",
    "pino": "catalog:pino",
    "pino-abstract-transport": "catalog:pino",
    "pino-pretty": "catalog:pino",
    "pythonia": "catalog:py",
    "redis": "catalog:redis",
    "sharp": "catalog:sharp",
    "tiktoken": "catalog:tiktoken",
    "tslib": "catalog:tslib",
    "typescript": "catalog:ts",
    "ws": "catalog:ws"
  },
  "devDependencies": {
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "nodemon": "catalog:node",
    "prettier": "catalog:prettier",
    "rolldown": "catalog:rolldown",
    "tsdown": "catalog:tsdown",
    "tsx": "catalog:tsx",
    "typescript-eslint": "catalog:tseslint",
    "wait-on": "catalog:utils"
  }
}
