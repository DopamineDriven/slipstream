{
  "extends": "@slipstream/tsconfig/node-pkg.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "outDir": "dist",
    "emitDeclarationOnly": true,
    "ignoreDeprecations":"6.0",
    "types": ["*"]
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  "exclude": ["dist", "public/inspect/**/*"]
}
