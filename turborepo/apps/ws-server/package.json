{
  "name": "@slipstream/ws-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "anthropic": [
        "dist/anthropic/index.d.ts"
      ],
      "extract": [
        "dist/extract/index.d.ts"
      ],
      "gemini": [
        "dist/gemini/index.d.ts"
      ],
      "logger": [
        "dist/logger/index.d.ts"
      ],
      "meta": [
        "dist/meta/index.d.ts"
      ],
      "mixins": [
        "src/mixins/index.d.ts"
      ],
      "models": [
        "dist/models/index.d.ts"
      ],
      "openai": [
        "dist/openai/index.d.ts"
      ],
      "openai/workup": [
        "src/openai/workup.d.ts"
      ],
      "pdf": [
        "dist/pdf/index.d.ts"
      ],
      "prisma": [
        "dist/prisma/index.d.ts"
      ],
      "providers": [
        "src/providers/index.d.ts"
      ],
      "resolver": [
        "dist/resolver/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ],
      "vercel": [
        "dist/vercel/index.d.ts"
      ],
      "vercel/sse": [
        "dist/vercel/sse.d.ts"
      ],
      "ws-server": [
        "dist/ws-server/index.d.ts"
      ],
      "xai": [
        "dist/xai/index.d.ts"
      ],
      "xai/sse": [
        "dist/xai/sse.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "pre:build": "pnpm db:generate",
    "db:generate": "pnpm --filter \"@slipstream/db\" db:generate",
    "db:migrate": "pnpm --filter \"@slipstream/db\" db:migrate",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml,md}\" --ignore-unknown --cache",
    "prisma:studio": "pnpm --filter \"@slipstream/db\" prisma:studio",
    "clean": "git clean -xdf .turbo dist node_modules",
    "dev": "nodemon --watch src --ext ts --exit-child --exec \"tsx src/index.ts\"",
    "lint": "eslint",
    "start": "node dist/index.js"
  },
  "prettier": "@slipstream/prettier-config",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-s3": "^3.920.0",
    "@aws-sdk/client-secrets-manager": "^3.920.0",
    "@aws-sdk/credential-providers": "^3.920.0",
    "@aws-sdk/s3-request-presigner": "^3.920.0",
    "@aws-sdk/types": "^3.920.0",
    "@d0paminedriven/fs": "^7.6.0",
    "@d0paminedriven/metadata": "^3.3.0",
    "@google/genai": "^1.27.0",
    "@napi-rs/canvas": "^0.1.81",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-prometheus": "^0.207.0",
    "@opentelemetry/instrumentation-http": "^0.207.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.207.0",
    "@slipstream/credentials": "workspace:*",
    "@slipstream/db": "workspace:*",
    "@slipstream/encryption": "workspace:*",
    "@slipstream/img-gen": "workspace:*",
    "@slipstream/key-validator": "workspace:*",
    "@slipstream/redis-service": "workspace:*",
    "@slipstream/storage-s3": "workspace:*",
    "@slipstream/types": "workspace:*",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "bullmq": "^5.62.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "dotenv-expand": "^12.0.3",
    "llama-api-client": "^0.3.0",
    "node-html-parser": "^7.0.1",
    "openai": "^6.7.0",
    "p-limit": "^7.2.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-abstract-transport": "^3.0.0",
    "pino-pretty": "^13.1.2",
    "redis": "^5.9.0",
    "sharp": "^0.34.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unpdf": "^1.3.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/jest-presets": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "@types/jest": "^30.0.0",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "terser": "^5.44.0",
    "tsdown": "^0.15.12",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.46.2",
    "wait-on": "^9.0.1"
  }
}
