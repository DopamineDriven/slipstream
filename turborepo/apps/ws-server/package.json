{
  "name": "@slipstream/ws-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "source": "src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "anthropic": [
        "dist/anthropic/index.d.ts",
        "dist/anthropic/types.d.ts",
        "dist/anthropic/workup.d.ts"
      ],
      "byte-codec": [
        "dist/byte-codec/index.d.ts"
      ],
      "extract": [
        "dist/extract/index.d.ts"
      ],
      "gemini": [
        "dist/gemini/chat.d.ts",
        "dist/gemini/fss.d.ts",
        "dist/gemini/index.d.ts",
        "dist/gemini/types.d.ts",
        "dist/gemini/workup.d.ts"
      ],
      "image": [
        "dist/image/index.d.ts"
      ],
      "logger": [
        "dist/logger/index.d.ts"
      ],
      "meta": [
        "dist/meta/index.d.ts"
      ],
      "mixins": [
        "dist/mixins/index.d.ts"
      ],
      "models": [
        "dist/models/index.d.ts"
      ],
      "openai": [
        "dist/openai/gpt-image.d.ts",
        "dist/openai/index.d.ts",
        "dist/openai/responses-chat.d.ts",
        "dist/openai/responses-img-gen.d.ts",
        "dist/openai/types.d.ts",
        "dist/openai/workup.d.ts"
      ],
      "pdf": [
        "dist/pdf/index.d.ts"
      ],
      "prisma": [
        "dist/prisma/attachment-provider.d.ts",
        "dist/prisma/attachment.d.ts",
        "dist/prisma/chat.d.ts",
        "dist/prisma/index.d.ts",
        "dist/prisma/user-meta.d.ts",
        "dist/prisma/utils.d.ts"
      ],
      "providers": [
        "dist/providers/index.d.ts"
      ],
      "resolver": [
        "dist/resolver/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ],
      "vercel": [
        "dist/vercel/index.d.ts",
        "dist/vercel/sse.d.ts"
      ],
      "voyage": [
        "dist/voyage/index.d.ts",
        "dist/voyage/types.d.ts"
      ],
      "ws-server": [
        "dist/ws-server/index.d.ts"
      ],
      "xai": [
        "dist/xai/collections.d.ts",
        "dist/xai/event-types.ts",
        "dist/xai/img-gen.ts",
        "dist/xai/index.d.ts",
        "dist/xai/response-sse.d.ts",
        "dist/xai/responses-api.d.ts",
        "dist/xai/responses-types.d.ts",
        "dist/xai/types.d.ts",
        "dist/xai/workup.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "pre:build": "pnpm db:generate",
    "db:generate": "pnpm --filter @slipstream/db db:generate",
    "db:migrate": "pnpm --filter @slipstream/db db:migrate",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml,md}\" --ignore-unknown --cache",
    "prisma:studio": "pnpm --filter @slipstream/db prisma:studio",
    "clean": "git clean -xdf .turbo dist node_modules",
    "dev": "nodemon --watch src --ext ts --exit-child --exec \"tsx src/index.ts\"",
    "lint": "eslint",
    "typecheck": "tsgo --noEmit",
    "start": "node dist/index.js",
    "test": "node --test --import tsx --test-reporter spec"
  },
  "prettier": "@slipstream/prettier-config",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@aws-sdk/client-s3": "catalog:aws",
    "@aws-sdk/client-secrets-manager": "catalog:aws",
    "@aws-sdk/credential-providers": "catalog:aws",
    "@aws-sdk/s3-request-presigner": "catalog:aws",
    "@aws-sdk/types": "catalog:aws",
    "@d0paminedriven/fs": "catalog:dd",
    "@d0paminedriven/metadata": "catalog:dd",
    "@google/genai": "^1.38.0",
    "@napi-rs/canvas": "^0.1.89",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@slipstream/credentials": "workspace:*",
    "@slipstream/db": "workspace:*",
    "@slipstream/encryption": "workspace:*",
    "@slipstream/img-gen": "workspace:*",
    "@slipstream/key-validator": "workspace:*",
    "@slipstream/redis-service": "workspace:*",
    "@slipstream/storage-s3": "workspace:*",
    "@slipstream/types": "workspace:*",
    "@types/node": "catalog:node",
    "@types/ws": "catalog:ws",
    "@typescript/native-preview": "catalog:tsgo",
    "bullmq": "^5.67.2",
    "dotenv": "catalog:dotenv",
    "dotenv-cli": "catalog:dotenv",
    "dotenv-expand": "catalog:dotenv",
    "llama-api-client": "^0.3.0",
    "nanoid": "^5.1.6",
    "node-html-parser": "^7.0.2",
    "openai": "^6.17.0",
    "p-limit": "^7.2.0",
    "pino": "catalog:pino",
    "pino-abstract-transport": "catalog:pino",
    "pino-pretty": "catalog:pino",
    "pythonia": "^1.2.6",
    "redis": "catalog:redis",
    "sharp": "catalog:sharp",
    "tiktoken": "^1.0.22",
    "tslib": "catalog:tslib",
    "typescript": "catalog:ts",
    "unpdf": "^1.4.0",
    "ws": "catalog:ws"
  },
  "devDependencies": {
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "nodemon": "^3.1.11",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:tsdown",
    "tsx": "catalog:tsx",
    "typescript-eslint": "catalog:tseslint",
    "wait-on": "^9.0.3"
  }
}
