{
  "name": "@slipstream/types",
  "version": "1.0.1",
  "description": "convenient type definitions",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/index.d.ts"
        ],
        "events-images": [
          "dist/events-images.d.ts"
        ],
        "events-workup": [
          "dist/events-workup.d.ts"
        ],
        "events": [
          "dist/events.d.ts"
        ],
        "models": [
          "dist/models.d.ts"
        ],
        "utils": [
          "dist/utils.d.ts"
        ],
        "types": [
          "dist/types.d.ts"
        ],
        "codegen": [
          "dist/codegen/*.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "events-images": [
        "dist/events-images.d.ts"
      ],
      "events-workup": [
        "dist/events-workup.d.ts"
      ],
      "events": [
        "dist/events.d.ts"
      ],
      "models": [
        "dist/models.d.ts"
      ],
      "utils": [
        "dist/utils.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ],
      "codegen": [
        "dist/codegen/*.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,mjs,d.ts,d.cts,d.mts}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./utils": "./dist/utils.js",
    "./types": "./dist/types.js",
    "./models": "./dist/models.js",
    "./events-images": "./dist/events-images.js",
    "./events-workup": "./dist/events-workup.js",
    "./events": "./dist/events.js",
    "./codegen/*": "./dist/codegen/*.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm build",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml}\" --ignore-unknown --cache",
    "clean": "git clean -xdf .turbo dist node_modules",
    "pregen:media": "pnpm tsx src/codegen/index.ts --target video",
    "gen:media": "pnpm tsx src/codegen/index.ts --target img",
    "pregen": "pnpm gen:media",
    "gen": "pnpm tsx src/codegen/index.ts --target default",
    "postgen": "pnpm format"
  },
  "devDependencies": {
    "@d0paminedriven/fs": "^7.6.0",
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "@types/node": "^24.9.2",
    "chokidar": "^4.0.3",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "eslint": "^9.39.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "terser": "^5.44.0",
    "tsdown": "^0.15.12",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "prettier": "@slipstream/prettier-config"
}
