{
  "name": "@slipstream/credentials",
  "version": "1.0.0",
  "description": "convenient credentials util",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "creds": [
          "dist/creds/index.d.ts"
        ],
        "types": [
          "dist/types/index.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "creds": [
        "dist/creds/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,d.ts,d.cts,css}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./creds": "./dist/creds/index.js",
    "./types": "./dist/types/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm build",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml,css,html,md}\" --ignore-unknown --cache",
    "update:secrets": "tsx src/service/automate.ts",
    "postupdate:secrets": "bash ./remote-helper.sh",
    "clean": "git clean -xdf .turbo dist node_modules",
    "fix": "npm pkg fix"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.913.0",
    "@aws-sdk/credential-providers": "^3.913.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3"
  },
  "devDependencies": {
    "@d0paminedriven/fs": "^7.6.0",
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "@types/node": "^24.8.1",
    "chokidar": "^4.0.3",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.38.0",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "terser": "^5.44.0",
    "tsdown": "^0.15.8",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "prettier": "@slipstream/prettier-config"
}
