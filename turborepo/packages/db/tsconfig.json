{
  "extends": "@slipstream/tsconfig/node-pkg.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "paths": {
      "@/*": ["./src/*"]
    },
    "exactOptionalPropertyTypes": true,
    "declarationMap": true,
    "outDir": "dist",
            "ignoreDeprecations":"6.0",
    "types": ["*"]
  },
  "exclude": ["dist"],
  "include": ["src/**/*.ts", "**/*.ts"]
}
