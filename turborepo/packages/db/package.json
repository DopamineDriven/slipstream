{
  "name": "@slipstream/db",
  "version": "1.0.0",
  "description": "convenient db helpers",
  "type": "module",
  "sideEffects": [
    "**/*.wasm"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup",
    "lint": "eslint",
    "format": "prisma format",
    "clean": "git clean -xdf .turbo dist node_modules",
    "prebuild": "rm -rf dist/ && pnpm db:generate",
    "predev": "pnpm db:generate",
    "db:generate": "prisma generate --sql",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio --browser none --port 7777",
    "precp:binaries": "tsx src/test/scan-output.ts --scan output",
    "cp:binaries": "cp -r ./src/generated/prisma/*.x.so.node ./dist/generated/prisma"
  },
  "files": [
    "dist/**",
    "prisma/**",
    "package.json"
  ],
  "exports": {
    "./factory": {
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js",
      "default": "./dist/factory.js"
    },
    "./node": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "default": "./dist/db.js"
    },
    "./db-accelerate": {
      "types": "./dist/db-accelerate.d.ts",
      "import": "./dist/db-accelerate.js",
      "default": "./dist/db-accelerate.js"
    },
    "./node/generated/client": {
      "types": "./dist/client-node.d.ts",
      "import": "./dist/client-node.js",
      "default": "./dist/client-node.js"
    },
    "./node/generated/models": {
      "types": "./dist/models-node.d.ts",
      "import": "./dist/models-node.js",
      "default": "./dist/models-node.js"
    },
    "./sql-node": {
      "types": "./dist/sql-node.d.ts",
      "import": "./dist/sql-node.js",
      "default": "./dist/sql-node.js"
    },
    "./enums-node": {
      "types": "./dist/enums-node.d.ts",
      "import": "./dist/enums-node.js",
      "default": "./dist/enums-node.js"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:prisma",
    "@prisma/client": "catalog:prisma",
    "@prisma/client-runtime-utils": "catalog:prisma",
    "@prisma/extension-accelerate": "catalog:prisma",
    "dotenv": "catalog:dotenv"
  },
  "devDependencies": {
    "@d0paminedriven/fs": "catalog:dd",
    "@slipstream/credentials": "workspace:*",
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@types/pg": "catalog:pg",
    "@typescript/native-preview": "catalog:tsgo",
    "dotenv": "catalog:dotenv",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "pg": "catalog:pg",
    "prettier": "catalog:prettier",
    "prisma": "catalog:prisma",
    "tslib": "catalog:tslib",
    "tsup": "catalog:tsup",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint"
  },
  "prettier": "@slipstream/prettier-config"
}
