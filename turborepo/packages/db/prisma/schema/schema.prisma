datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client"
  previewFeatures = ["typedSql", "postgresqlExtensions"]
  output          = "../../src/generated/prisma"
  runtime         = "nodejs"
}

generator edge {
  provider        = "prisma-client-js"
  output          = "../../edge/generated/client"
  runtime         = "vercel-edge"
  previewFeatures = ["typedSql", "postgresqlExtensions"]
}

enum Provider {
  OPENAI
  GROK
  GEMINI
  ANTHROPIC
  META
  VERCEL
}

model User {
  id                      String                   @id @default(cuid(2))
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  email_verified          Boolean?
  image                   String?
  isAnonymous             Boolean?
  lastLoginMethod         String?
  profile                 Profile?
  accounts                Account[]
  sessions                Session[]
  keys                    UserKey[]
  attachments             Attachment[]
  conversations           Conversation[]
  conversationMemoryStore ConversationMemoryStore?
  providerStores          ProviderStore[]
  localVectorStores       LocalVectorStore[]
  settings                Settings?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
}
