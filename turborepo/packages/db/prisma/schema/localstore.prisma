enum VisualMediaHint {
  animations
  charts
  drawings
  images
  mixed
  slides
}

enum LocalStoreDocState {
  QUEUED
  PENDING
  PROCESSING
  ACTIVE
  FAILED
}

enum LocalStoreSchemaVersion {
  v1_0
}

model LocalVectorStore {
  id                    String   @id @default(cuid(2))
  userId                String
  provider              Provider
  storeName             String
  defaultEmbeddingModel String   @default("voyage-context-3")
  embeddingDim          Int      @default(1024)

  fileCount   Int     @default(0)
  totalBytes  BigInt?
  totalChunks Int     @default(0)

  schemaVersion LocalStoreSchemaVersion @default(v1_0)
  lastSyncedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  docs LocalVectorStoreDoc[]

  @@unique([userId, provider], name: "userId_provider_local")
  @@index([provider, storeName])
}

model LocalVectorStoreDoc {
  id             String   @id @default(cuid(2))
  storeId        String
  attachmentId   String
  conversationId String
  messageId      String
  provider       Provider

  provenanceId String // ${conversationId}-${messageId}-${attachmentId}-${hexFilename}.${ext}
  filename     String
  mimeType     String
  ext          String
  size         BigInt?

  schemaVersion  LocalStoreSchemaVersion @default(v1_0)
  // Embedding config (per-doc)
  embeddingModel String                  @default("voyage-context-3") // "voyage-context-3" (if no media detected or a txt based file) | "voyage-multimodal-3.5" (for preservation of all media in embedded context)
  embeddingDim   Int                     @default(1024) // 256 | 512 | 1024 | 2048

  hasVisualMedia       Boolean            @default(false)
  visualMediaHint      VisualMediaHint?
  pageCount            Int?
  extractedTextLength  Int?
  imageCount           Int?
  modelSelectionReason String? // "mime:application/pdf" | "probe:hasVisualMedia" | etc
  indexedAt            DateTime?
  errorMessage         String?
  lastAccessed         DateTime?
  state                LocalStoreDocState @default(PENDING)

  chunkCount Int @default(0)
  tokenCount Int @default(0)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      LocalVectorStore           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  attachment Attachment                 @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  chunks     LocalVectorStoreDocChunk[]

  @@unique([storeId, provenanceId])
  @@index([storeId, state])
  @@index([storeId, embeddingModel])
  @@index([provenanceId])
  @@index([attachmentId])
  @@index([conversationId])
  @@index([hasVisualMedia])
  @@index([schemaVersion])
}

model LocalVectorStoreDocChunk {
  id                String @id @default(cuid(2))
  docId             String
  storeId           String // denormalized for direct vector queries
  chunkProvenanceId String // ${provenanceId}#${chunkIndex}

  provenanceId   String // Denormalized for direct lookups
  attachmentId   String
  conversationId String
  messageId      String

  chunkIndex  Int
  content     String @db.Text
  contentHash String // sha256(content + offsets + schemaVersion)

  tokenCount  Int
  startOffset Int?
  endOffset   Int?

  embedding Unsupported("vector(1024)")

  schemaVersion LocalStoreSchemaVersion @default(v1_0)
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doc LocalVectorStoreDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, chunkIndex, schemaVersion])
  @@index([docId])
  @@index([storeId])
  @@index([attachmentId])
  @@index([conversationId, messageId])
  @@index([contentHash])
  @@index([embedding], map: "idx_local_doc_chunk_embedding_hnsw")
  @@index([storeId], map: "idx_local_doc_chunk_store_active")
}
