{
  "name": "@slipstream/storage-s3",
  "version": "1.0.0",
  "description": "convenient s3 storage helpers",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "s3": [
          "dist/s3/index.d.ts"
        ],
        "utils": [
          "dist/utils/index.d.ts"
        ],
        "types": [
          "dist/types/index.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "s3": [
        "dist/s3/index.d.ts"
      ],
      "utils": [
        "dist/utils/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,d.ts,d.cts,css}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./utils": "./dist/utils/index.js",
    "./s3": "./dist/s3/index.js",
    "./types": "./dist/types/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm build",
    "lint": "eslint",
    "clean": "git clean -xdf .turbo dist node_modules",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml,css,html,md}\" --ignore-unknown --cache"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:aws",
    "@aws-sdk/credential-providers": "catalog:aws",
    "@aws-sdk/lib-storage": "catalog:aws",
    "@aws-sdk/s3-request-presigner": "catalog:aws",
    "@aws-sdk/types": "catalog:aws",
    "@smithy/node-http-handler": "catalog:smithy",
    "@slipstream/types": "workspace:*"
  },
  "devDependencies": {
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@typescript/native-preview": "catalog:tsgo",
    "dotenv": "catalog:dotenv",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint"
  },
  "prettier": "@slipstream/prettier-config"
}
