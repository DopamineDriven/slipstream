{
  "name": "@slipstream/storage-s3",
  "version": "1.0.0",
  "description": "convenient s3 storage helpers",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "s3": [
          "dist/s3/index.d.ts"
        ],
        "utils": [
          "dist/utils/index.d.ts"
        ],
        "types": [
          "dist/types/index.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "s3": [
        "dist/s3/index.d.ts"
      ],
      "utils": [
        "dist/utils/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,d.ts,d.cts,css}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./utils": "./dist/utils/index.js",
    "./s3": "./dist/s3/index.js",
    "./types": "./dist/types/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm build",
    "lint": "eslint",
    "clean": "git clean -xdf .turbo dist node_modules",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml,css,html,md}\" --ignore-unknown --cache"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.946.0",
    "@aws-sdk/credential-providers": "^3.946.0",
    "@aws-sdk/lib-storage": "^3.946.0",
    "@aws-sdk/s3-request-presigner": "^3.946.0",
    "@aws-sdk/types": "^3.936.0",
    "@smithy/node-http-handler": "^4.4.5",
    "@slipstream/types": "workspace:*"
  },
  "devDependencies": {
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "@types/node": "^24.10.1",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "chokidar": "^5.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "terser": "^5.44.1",
    "tsdown": "^0.17.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  },
  "prettier": "@slipstream/prettier-config"
}
