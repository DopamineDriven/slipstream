{
  "name": "@slipstream/encryption",
  "version": "1.0.0",
  "description": "convenient encryption util",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/*.d.ts",
          "dist/*/index.d.ts"
        ],
        "encryption": [
          "dist/encryption/index.d.ts"
        ],
        "types": [
          "dist/types/index.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ],
      "encryption": [
        "dist/encryption/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,d.ts,d.cts,css}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./encryption": "./dist/encryption/index.js",
    "./types": "./dist/types/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm build",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml,css,html,md}\" --ignore-unknown --cache",
    "clean": "git clean -xdf .turbo dist node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.958.0",
    "@aws-sdk/credential-providers": "^3.958.0",
    "@slipstream/credentials": "workspace:*",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3"
  },
  "devDependencies": {
    "@d0paminedriven/fs": "^11.0.0",
    "@slipstream/eslint-config": "workspace:*",
    "@slipstream/prettier-config": "workspace:*",
    "@slipstream/tsconfig": "workspace:*",
    "@types/node": "catalog:node25",
    "@typescript/native-preview": "catalog:tsgo7",
    "chokidar": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "catalog:eslint",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "terser": "^5.44.1",
    "tsdown": "catalog:tsdown",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:ts6",
    "typescript-eslint":"catalog:tseslint"
  },
  "prettier": "@slipstream/prettier-config"
}
